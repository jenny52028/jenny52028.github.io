---
import Base from '../layouts/Base.astro';
import LeafIcon from '../components/LeafIcon.astro';
import { url } from '../lib/posts';
---

<Base title="页面不见了">
  <section class="card notfound">
    <div class="icon"><LeafIcon /></div>
    <h1>这片叶子飘走了</h1>
    <p>你要找的页面不存在，可能是网址打错了，或者文章已经搬家。</p>
    <a class="home" href={url('/')}>回首页</a>
  </section>
</Base>

<style>
  .notfound { max-width: 520px; margin: 64px auto 0; padding: 44px 24px; text-align: center; }
  .icon { width: 56px; height: 56px; margin: 0 auto 12px; color: var(--accent); }
  .icon :global(svg) { width: 100%; height: 100%; }
  h1 { margin: 0; font-size: 26px; color: var(--title); }
  p { color: var(--muted); }
  .home {
    display: inline-block;
    margin-top: 8px;
    padding: 8px 24px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
  }
  .home:hover { background: var(--accent-strong); color: #fff; }
</style>
