---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import T from '../components/T.astro';
import { SITE, HOME } from '../site.config';
import { url } from '../lib/posts';
import { Content as About } from '../../关于我.md';
---

<Base description={HOME.intro}>
  <section class="hero">
    <div class="intro">
      <p class="hello"><span class="dot" aria-hidden="true"></span>HELLO, THIS IS MY SPACE</p>
      <p class="role"><T zh={HOME.role} en={HOME.roleEn} /></p>
      <h1>
        <span class="i18n-zh">你好，<br />我是<mark>{SITE.author}</mark>。</span>
        <span class="i18n-en" lang="en">Hi,<br />I'm <mark>{SITE.authorEn}</mark>.</span>
      </h1>
      <p class="lead"><T zh={HOME.intro} en={HOME.introEn} /></p>
      <div class="actions">
        <a class="primary" href={url('/blog/')}><T zh="看看我的博客" en="Read my blog" /><span aria-hidden="true">→</span></a>
        <a class="secondary" href={SITE.douyin} target="_blank" rel="noopener noreferrer"><T zh="在抖音找到我" en="Find me on Douyin" /> ↗</a>
      </div>
    </div>

    <div class="visual">
      <Avatar />
    </div>

    <a class="scroll-hint" href="#about"><T zh="向下认识我" en="Get to know me" /> ↓</a>
  </section>

  <section class="about" id="about">
    <p class="section-no">QINGYE / 01</p>
    <h2><T zh="关于我" en="About me" /></h2>
    <p class="i18n-en lang-note" lang="en">This section is in Chinese.</p>
    <div class="about-body"><About /></div>
    <a class="primary" href={url('/blog/')}><T zh="去看看博客" en="Go to the blog" /><span aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    min-height: calc(100vh - var(--header-h));
    padding: 32px 0 64px;
  }
  /* 点阵背景，铺满整屏宽 */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .hello { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 13px; letter-spacing: 0.22em; color: var(--muted); }
  .dot { width: 8px; height: 8px; border: 2px solid var(--accent); border-radius: 50%; }
  .role { margin: 28px 0 0; font-size: 18px; color: var(--title); }

  h1 {
    margin: 18px 0 0;
    font-size: clamp(48px, 7vw, 92px);
    line-height: 1.12;
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--title);
  }
  mark {
    color: inherit;
    background: linear-gradient(transparent 72%, #b9de8c 72%, #b9de8c 92%, transparent 92%);
  }

  .lead { max-width: 30em; margin: 28px 0 0; font-size: 19px; line-height: 1.8; color: var(--muted); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 40px; }
  .primary {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 14px 26px;
    border-radius: 12px;
    background: var(--accent);
    color: #fff;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--title);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .primary:hover { color: #fff; transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--title); }
  .secondary { color: var(--title); font-size: 16px; text-decoration: none; }
  .secondary:hover { text-decoration: underline; }

  .scroll-hint {
    position: absolute;
    right: 0;
    bottom: 20px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .about {
    max-width: 780px;
    margin: 24px auto 0;
    padding: 40px 44px;
    background: var(--card);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .section-no { margin: 0; font-size: 12px; letter-spacing: 0.2em; color: var(--accent); }
  .about h2 { margin: 6px 0 12px; font-size: 28px; color: var(--title); }
  .about-body { line-height: 1.9; }
  .about-body :global(h2) { margin: 1.6em 0 0.4em; font-size: 19px; color: var(--title); }
  .about-body :global(ul) { padding-left: 1.4em; }
  .about .primary { margin-top: 20px; padding: 10px 22px; font-size: 15px; gap: 16px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; padding: 32px 0 48px; }
    .visual { max-width: 420px; width: 100%; margin: 0 auto; }
    .scroll-hint { position: static; justify-self: center; }
  }
  @media (max-width: 640px) {
    .role { margin-top: 20px; }
    .lead { font-size: 17px; }
    .actions { gap: 18px; margin-top: 30px; }
    .about { padding: 26px 20px; }
  }
</style>
