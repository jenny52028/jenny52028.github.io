---
// 首页右边的青叶卡通形象，带浮动动画
import { HOME } from '../site.config';
import { url } from '../lib/posts';

const avatar = url(HOME.avatar);
---

<div class="stage">
  <svg class="rings" viewBox="0 0 400 400" aria-hidden="true">
    <ellipse cx="200" cy="200" rx="190" ry="120" />
    <ellipse cx="200" cy="200" rx="170" ry="185" />
  </svg>
  <svg class="star star-1" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.8 6.6 4.4 10.4 12 12-7.6 1.6-11.2 5.4-12 12-.8-6.6-4.4-10.4-12-12C7.6 10.4 11.2 6.6 12 0z" /></svg>
  <svg class="star star-2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19" /></svg>
  <svg class="star star-3" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.8 6.6 4.4 10.4 12 12-7.6 1.6-11.2 5.4-12 12-.8-6.6-4.4-10.4-12-12C7.6 10.4 11.2 6.6 12 0z" /></svg>

  <div class="float">
    <img src={avatar} alt="青叶的卡通形象" width="900" height="876" fetchpriority="high" />
  </div>
</div>

<style>
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }
  .rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 3 6;
    animation: spin 60s linear infinite;
  }
  .float {
    position: relative;
    width: 86%;
    animation: float 5s ease-in-out infinite;
  }
  .float img { display: block; width: 100%; height: auto; filter: drop-shadow(0 18px 24px rgba(23, 52, 4, 0.12)); }

  .star { position: absolute; animation: twinkle 3.2s ease-in-out infinite; }
  .star-1 { top: 10%; left: 6%; width: 34px; fill: var(--title); }
  .star-2 { bottom: 12%; right: 4%; width: 34px; fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; animation-delay: 1.1s; }
  .star-3 { top: 4%; right: 18%; width: 16px; fill: var(--accent); animation-delay: 2s; }

  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes twinkle { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.8); } }

  @media (prefers-reduced-motion: reduce) {
    .rings, .float, .star { animation: none; }
  }
</style>
