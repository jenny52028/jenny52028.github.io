---
import LeafIcon from './LeafIcon.astro';
import T from './T.astro';
import { SITE } from '../site.config';
import { plural } from '../lib/posts';

interface Props {
  postCount: number;
  tagCount: number;
}

const { postCount, tagCount } = Astro.props;
---

<aside class="card profile">
  <div class="avatar"><LeafIcon /></div>
  <h2 class="name"><T zh={SITE.author} en={SITE.authorEn} /></h2>
  <p class="signature"><T zh={SITE.signature} en={SITE.signatureEn} /></p>
  <p class="counts"><T zh={`${postCount} 篇文章 · ${tagCount} 个标签`} en={`${plural(postCount, 'post')} · ${plural(tagCount, 'tag')}`} /></p>
</aside>

<style>
  .profile { text-align: center; padding: 28px 20px 22px; }
  .avatar {
    width: 88px;
    height: 88px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    display: grid;
    place-items: center;
    color: var(--accent);
  }
  .avatar :global(svg) { width: 44px; height: 44px; }
  .name { margin: 0; font-size: 20px; color: var(--title); }
  .signature { margin: 6px 0 0; color: var(--muted); font-size: 14px; }
  .counts {
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-size: 13px;
    color: var(--muted);
  }
</style>
