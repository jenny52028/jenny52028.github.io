---
import '../styles/global.css';
import LeafIcon from '../components/LeafIcon.astro';
import T from '../components/T.astro';
import { SITE } from '../site.config';
import { url } from '../lib/posts';

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
}

const { title, titleEn = title, description = SITE.heroText } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const fullTitleEn = titleEn ? `${titleEn} · ${SITE.name}` : SITE.name;

const path = Astro.url.pathname;
const nav = [
  { zh: '首页', en: 'Home', href: url('/'), active: path === url('/') },
  { zh: '博客', en: 'Blog', href: url('/blog/'), active: path.startsWith(url('/blog')) || path.startsWith(url('/posts/')) },
  { zh: '资源中心', en: 'Resources', href: url('/resources/'), active: path.startsWith(url('/resources')) },
  { zh: '标签', en: 'Tags', href: url('/tags/'), active: path.startsWith(url('/tags/')) },
];
---

<!doctype html>
<html lang="zh-CN" data-lang="zh" data-title-zh={fullTitle} data-title-en={fullTitleEn}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        if (localStorage.getItem('qingye-lang') === 'en') {
          const html = document.documentElement;
          html.dataset.lang = 'en';
          html.lang = 'en';
          document.title = html.dataset.titleEn;
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={url('/')}><LeafIcon />{SITE.name}</a>

        <nav class="nav" aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.active ? 'page' : undefined}><T zh={item.zh} en={item.en} /></a>
          ))}
        </nav>

        <div class="header-actions">
          <button type="button" class="lang-toggle" data-lang-toggle aria-label="切换语言 / Switch language">
            <span class="lang-zh">中</span><span aria-hidden="true">/</span><span class="lang-en">EN</span>
          </button>
          <a class="douyin" href={SITE.douyin} target="_blank" rel="noopener noreferrer">
            <span class="i18n-zh">在抖音找到我</span><span class="i18n-en" lang="en"><span class="hide-narrow">Find me on </span>Douyin</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} <T zh={`${SITE.author} · 用 Astro 搭建`} en={`${SITE.authorEn} · Built with Astro`} />
      </div>
    </footer>

    <script>
      const html = document.documentElement;
      const KEY = 'qingye-lang';

      // 切换语言：改 <html> 上的标记，CSS 负责显示对应文字；需要的地方监听 langchange 自己更新
      function setLang(lang: 'zh' | 'en') {
        html.dataset.lang = lang;
        html.lang = lang === 'en' ? 'en' : 'zh-CN';
        document.title = (lang === 'en' ? html.dataset.titleEn : html.dataset.titleZh) ?? document.title;
        document.querySelectorAll<HTMLInputElement>('[data-ph-zh]').forEach((el) => {
          el.placeholder = (lang === 'en' ? el.dataset.phEn : el.dataset.phZh) ?? '';
        });
        try { localStorage.setItem(KEY, lang); } catch {}
        window.dispatchEvent(new CustomEvent('langchange', { detail: lang }));
      }

      document.querySelector('[data-lang-toggle]')?.addEventListener('click', () => {
        setLang(html.dataset.lang === 'en' ? 'zh' : 'en');
      });

      if (html.dataset.lang === 'en') setLang('en');
    </script>
  </body>
</html>
