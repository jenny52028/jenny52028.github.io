---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="card page">
    <h1>{frontmatter.title}</h1>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .page { max-width: 780px; margin: 36px auto 0; padding: 36px 44px; line-height: 1.9; }
  h1 { margin: 0 0 8px; font-size: 30px; color: var(--title); }
  .prose :global(h2) { margin: 1.8em 0 0.5em; font-size: 20px; color: var(--title); }
  .prose :global(ul) { padding-left: 1.4em; }

  @media (max-width: 640px) {
    .page { margin-top: 16px; padding: 22px 18px; }
    h1 { font-size: 24px; }
  }
</style>
